# YouTube Data API v3 金鑰
# 請至 https://console.cloud.google.com/ 申請
YOUTUBE_API_KEY=your_youtube_api_key_here

# 輸出目錄設定
OUTPUT_DIR=./output

# 臨時檔案目錄
TEMP_DIR=./temp

# 剪輯緩衝時間（秒）
CLIP_BUFFER_SECONDS=2

# 影片下載品質（best/worst/720p/1080p）
VIDEO_QUALITY=720p

# 日誌等級（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO
